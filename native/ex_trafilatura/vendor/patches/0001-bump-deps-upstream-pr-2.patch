Bump ego-tree, html5ever, scraper and tendril

A port of upstream PR https://github.com/nchapman/trafilatura-rs/pull/2, which
fixes the `unwrap()` on `None` reported as upstream issue
https://github.com/nchapman/trafilatura-rs/issues/1 — reachable from `extract`
via `doc_cleaning` -> `strip_elements` -> `dom::tree::remove`.

The bumps are ego-tree 0.10->0.11, html5ever 0.36->0.39, scraper 0.25->0.26 and
tendril 0.4->0.5. All four are semver-incompatible, which is why no lockfile of
ours can produce them and the crate's own manifest has to change (ADR-0002).

Upstream's PR edits the repository's hand-written `Cargo.toml`; this patch edits
the normalised manifest that ships in the crates.io tarball. The four version
requirements it changes are the same four.

It also carries two things that are not upstream's and stay ours even if PR #2
ever merges: the `+extrafilatura.1` build-metadata marker on the version, and
the Apache-2.0 §4(b) modification notice. Both belong to this file, and this is
the only patch that touches it.

diff --git a/Cargo.toml b/Cargo.toml
index 4a933f0..0de7509 100644
--- a/Cargo.toml
+++ b/Cargo.toml
@@ -1,3 +1,14 @@
+# MODIFIED BY THE EXTRAFILATURA PROJECT (Apache-2.0 §4(b) notice)
+#
+# This is not the file published as `trafilatura` 0.3.0 on crates.io. Changed:
+#
+#   - the four dependency bumps from upstream PR
+#     https://github.com/nchapman/trafilatura-rs/pull/2
+#   - the version carries a `+extrafilatura.1` build-metadata marker, so
+#     `cargo tree` and SBOM tooling do not report this copy as stock 0.3.0
+#
+# See VENDOR.md in this directory for the full provenance.
+
 # THIS FILE IS AUTOMATICALLY GENERATED BY CARGO
 #
 # When uploading crates to the registry Cargo will automatically
@@ -13,7 +24,7 @@
 edition = "2021"
 rust-version = "1.85"
 name = "trafilatura"
-version = "0.3.0"
+version = "0.3.0+extrafilatura.1"
 build = false
 exclude = [
     "test-files/",
@@ -104,14 +115,14 @@ features = ["derive"]
 optional = true
 
 [dependencies.ego-tree]
-version = "0.10"
+version = "0.11"
 
 [dependencies.html2markdown]
 version = "0.2"
 optional = true
 
 [dependencies.html5ever]
-version = "0.36"
+version = "0.39"
 
 [dependencies.justext]
 version = "0.2"
@@ -128,7 +139,7 @@ features = ["blocking"]
 optional = true
 
 [dependencies.scraper]
-version = "0.25"
+version = "0.26"
 
 [dependencies.serde]
 version = "1"
@@ -138,7 +149,7 @@ features = ["derive"]
 version = "1"
 
 [dependencies.tendril]
-version = "0.4"
+version = "0.5"
 
 [dependencies.thiserror]
 version = "2"
