# The directory Mix will write compiled artifacts to.
/_build/

# If you run "mix test --cover", coverage assets end up here.
/cover/

# The directory Mix downloads your dependencies sources to.
/deps/

# Where third-party dependencies like ExDoc output generated docs.
/doc/

# Temporary files, for example, from tests.
/tmp/

# If the VM crashes, it generates a dump, let's ignore it too.
erl_crash.dump

# Also ignore archive artifacts (built via "mix archive.build").
*.ez

# Ignore package tarball (built via "mix hex.build").
ex_trafilatura-*.tar

# Where cargo writes the NIF crate's build artifacts. Cargo.lock is tracked.
/native/ex_trafilatura/target/

# What tools/verify/drift.sh fetches and produces. The corpus is upstream's and
# is cloned on demand rather than vendored (ADR-0003 §2); the dumps and the
# escalation clone are working artifacts of one run. Only the result is kept,
# and it is kept in VENDOR.md.
/tools/verify/.corpus/
/tools/verify/.drift/
/tools/verify/drift/*/target/

# Claude Code local state: personal settings and scratch worktrees.
# Nothing here is shared — the agent docs that are meant to be tracked live
# in docs/agents/. If shared config is added later (e.g. .claude/settings.json
# or .claude/skills/), un-ignore it with a negation below this line.
/.claude/

